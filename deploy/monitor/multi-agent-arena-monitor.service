[Unit]
Description=Check Multi-Agent Algorithmic Arena runtime health
Wants=network-online.target
Wants=multi-agent-arena-sandbox-controller.service
After=docker.service network-online.target multi-agent-arena-sandbox-controller.service
Requires=docker.service

[Service]
Type=oneshot
User=root
StateDirectory=multi-agent-arena-monitor
EnvironmentFile=/etc/multi-agent-arena/monitor.env
ExecStart=/usr/local/sbin/multi-agent-arena-monitor-alert